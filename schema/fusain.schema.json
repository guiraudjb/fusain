{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guiraudjb.github.io/fusain/schema/fusain.schema.json",
  "title": "Document FUSAIN",
  "description": "Format de sauvegarde de FUSAIN, version 3. Le fichier ne contient que du texte, des nombres et des listes fermées : ni HTML, ni SVG, ni script. La validation appliquée par l'application (js/fichier.js) est la référence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "application", "document", "pages"],
  "properties": {
    "format": { "const": "fusain" },
    "formatVersion": { "type": "integer", "minimum": 1, "maximum": 3, "description": "2 depuis FUSAIN 0.3.0 (ajout de sousTitre et description) ; 3 depuis FUSAIN 0.32.1 (ajout de reseaux). Un fichier de version 1 ou 2 reste lisible." },
    "application": { "type": "string", "maxLength": 20 },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titre", "creeLe", "modifieLe", "theme"],
      "properties": {
        "titre": { "type": "string", "maxLength": 200 },
        "creeLe": { "type": "string", "format": "date-time" },
        "modifieLe": { "type": "string", "format": "date-time" },
        "theme": { "enum": ["bleu-france", "rouge-marianne", "vert-emeraude", "bleu-ecume", "brun-caramel", "contraste", "monochrome"] }
      }
    },
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 365,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nom", "format", "orientation", "margesMm", "titre", "piedDePage", "ajustement", "code"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
          "nom": { "type": "string", "maxLength": 100 },
          "format": { "enum": ["A4", "A3"] },
          "orientation": { "enum": ["portrait", "paysage"] },
          "margesMm": { "type": "number", "minimum": 0, "maximum": 50 },
          "titre": { "type": "string", "maxLength": 200 },
          "sousTitre": { "type": "string", "maxLength": 200 },
          "description": { "type": "string", "maxLength": 1000, "description": "Description accessible du schéma, reprise dans le SVG (élément desc)" },
          "piedDePage": { "type": "string", "maxLength": 200, "description": "Jetons remplacés à l'affichage : {n}, {total}, {date}" },
          "ajustement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "echelle", "alignement"],
            "properties": {
              "mode": { "enum": ["page", "largeur", "hauteur", "manuel"] },
              "echelle": { "type": "number", "minimum": 10, "maximum": 400 },
              "alignement": { "enum": ["haut", "centre", "bas"] }
            }
          },
          "type": { "type": "string", "pattern": "^[A-Za-z0-9-]{0,40}$", "description": "Indicatif : recalculé à partir du code à chaque ouverture" },
          "code": { "type": "string", "maxLength": 50000, "description": "Code Mermaid de la page, seule représentation enregistrée du schéma" }
        }
      }
    },
    "reseaux": {
      "type": "array", "maxItems": 50,
      "description": "Facultatif. Topologies lues à l'import d'un réseau (modèles réseau), pour la liaison de bout en bout ; 60 000 équipements et 120 000 liaisons au plus en tout.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["nom", "equipements", "liaisons"],
        "properties": {
          "nom": { "type": "string", "maxLength": 100, "description": "Nom du fichier importé" },
          "equipements": {
            "type": "array", "description": "[nom, icône « jeu:nom » ou vide, 1 pour un passage (commutateur, routeur, pare-feu) sinon 0]",
            "items": { "type": "array", "minItems": 3, "items": false, "prefixItems": [{ "type": "string", "minLength": 1, "maxLength": 200 }, { "type": "string", "maxLength": 80, "pattern": "^([a-z]+:[a-z0-9-]+)?$" }, { "enum": [0, 1] }] }
          },
          "liaisons": {
            "type": "array", "description": "[rang du premier équipement, rang du second, ports, VLAN]",
            "items": { "type": "array", "minItems": 4, "items": false, "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }, { "type": "string", "maxLength": 200 }, { "type": "string", "maxLength": 500 }] }
          }
        }
      }
    }
  }
}
